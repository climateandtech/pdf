[Unit]
Description=Agent speech NATS worker (Docling Whisper + Kokoro)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/home/smoldocling/apps/pdf
EnvironmentFile=-/home/smoldocling/apps/pdf/.env
Environment=AUDIO_TRANSCRIBE_SUBJECT=audio.command.transcribe
Environment=AUDIO_SYNTHESIZE_SUBJECT=audio.command.synthesize
Environment=BOT_VOICE_STT_MODEL=whisper_tiny
Environment=BOT_VOICE_TTS_VOICE=af_nicole
Environment=BOT_VOICE_TTS_SPEED=0.9
Environment=BOT_VOICE_TTS_PITCH=0.92
# Docling venv. Kokoro is the extra in requirements-speech.txt (CPU).
ExecStart=/home/smoldocling/apps/pdf/venv/bin/python /home/smoldocling/apps/pdf/speech_worker.py
Restart=always
RestartSec=10
StandardOutput=append:/home/smoldocling/apps/pdf/speech-worker.log
StandardError=append:/home/smoldocling/apps/pdf/speech-worker.log

[Install]
WantedBy=default.target
