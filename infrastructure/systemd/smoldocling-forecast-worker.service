[Unit]
Description=Timestral forecast NATS worker (smoldocling)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/home/smoldocling/apps/pdf
EnvironmentFile=-/home/smoldocling/apps/pdf/.env
Environment=FORECAST_DEVICE=cuda
Environment=FORECAST_INFER_SUBJECT=forecast.infer
# Own venv. Do not point this unit at the Docling venv.
ExecStart=/home/smoldocling/apps/pdf/venv-forecast/bin/python /home/smoldocling/apps/pdf/forecast_worker.py
Restart=always
RestartSec=10
StandardOutput=append:/home/smoldocling/apps/pdf/forecast-worker.log
StandardError=append:/home/smoldocling/apps/pdf/forecast-worker.log

[Install]
WantedBy=default.target
